<resources xmlns:tools="http://schemas.android.com/tools">
  <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:enforceNavigationBarContrast" tools:targetApi="29">true</item>
    <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    <item name="colorPrimary">@color/colorPrimary</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <item name="android:windowTranslucentStatus">true</item>
    <item name="android:windowTranslucentNavigation">true</item>
  </style>
  <!-- Android 12 이전 버전 (API 30 이하)을 위한 스플래시 스크린 스타일.
       반드시 androidx의 Theme.SplashScreen 을 상속해야 한다. 그래야 core-splashscreen 호환 경로가
       스플래시 뷰(splash_screen_view.xml)를 인플레이트할 때 splashScreenIconSize 등 필수 속성을
       찾을 수 있고, 구형 기기(예: 갤럭시 노트9/Android 10)에서 InflateException(getLayoutDimension)
       으로 즉시 강제 종료되는 문제를 막는다. (values-v31 버전과 동일한 룩을 유지) -->
  <style name="Theme.App.SplashScreen" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@color/splashscreen_background</item>
    <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    <item name="postSplashScreenTheme">@style/AppTheme</item>
  </style>
</resources>